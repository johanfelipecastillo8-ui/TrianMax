# Copiar a server/.env para desarrollar en local. En Render se definen las
# variables en el panel; dotenv nunca sobrescribe las variables del entorno.

# Supabase → Settings → Database → Connection string (URI).
# Usa la conexión directa (puerto 5432) o el Session pooler (5432).
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require
# También se acepta SUPABASE_DB_URL en lugar de DATABASE_URL.
# SUPABASE_DB_URL=

PORT=3000
ADMIN_PASSWORD=trianmax2026

# Cloudinary sigue siendo el respaldo de la base y el almacén de imágenes.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=trianmax

# Solo para un PostgreSQL local sin TLS:
# PGSSLMODE=disable
